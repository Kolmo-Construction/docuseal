<%
  # Where the header logo links. When PRODUCT_LOGO_LINK_URL is set, the
  # logo + name link to that URL (open in a new tab). Otherwise it links
  # to the DocuSeal root, which for a self-hosted single-account instance
  # is unhelpful for signers — set the env var so signers go back to the
  # company website.
  logo_link = ENV['PRODUCT_LOGO_LINK_URL'].presence || root_path
  is_external = logo_link.start_with?('http://', 'https://')
%>
<a href="<%= logo_link %>"<%= ' target="_blank" rel="noopener"'.html_safe if is_external %> class="mx-auto text-2xl md:text-3xl font-bold items-center flex space-x-3">
  <%= render 'shared/logo', class: 'w-12 h-12 md:w-14 md:h-14' %>
  <span><%= Docuseal.product_name %></span>
</a>
